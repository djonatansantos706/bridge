{
  "name": "nb_replace_lines",
  "description": "Substitui um trecho de código em um intervalo de linhas no buffer do NetBeans.",
  "parameters": {
    "type": "object",
    "properties": {
      "file": {
        "type": "string",
        "description": "Caminho absoluto do arquivo"
      },
      "start_line": {
        "type": "integer",
        "description": "Linha inicial (1-indexada)"
      },
      "end_line": {
        "type": "integer",
        "description": "Linha final (1-indexada)"
      },
      "target_content": {
        "type": "string",
        "description": "Texto exato existente a ser substituído"
      },
      "replacement_content": {
        "type": "string",
        "description": "Conteúdo de substituição"
      }
    },
    "required": [
      "file",
      "start_line",
      "end_line",
      "target_content",
      "replacement_content"
    ]
  }
}
