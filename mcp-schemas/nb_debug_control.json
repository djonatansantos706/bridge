{
  "name": "nb_debug_control",
  "description": "Controla a execução do depurador JPDA no NetBeans.",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "step_into",
          "step_over",
          "step_out",
          "continue",
          "pause",
          "stop"
        ],
        "description": "Ação de depuração a executar"
      }
    },
    "required": [
      "action"
    ]
  }
}